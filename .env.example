# ==============================================================================
# ZAROORAT MOBILITY ADMIN PANEL - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Available environments:
#   .env.local    -> Local developer workstation (VITE_API_BASE_URL=http://localhost:3000/api/v1)
#   .env.dev      -> Droplet development deployment (VITE_API_BASE_URL=https://dev-api.zaroorat.com/api/v1)
#   .env.staging  -> QA Staging deployment (VITE_API_BASE_URL=https://staging-api.zaroorat.com/api/v1)
#   .env.prod     -> Production release (VITE_API_BASE_URL=https://api.zaroorat.com/api/v1)

# Application Environment Mode: local | dev | staging | production
VITE_APP_ENV=local

# Backend Fastify API Base URL (must include /api/v1)
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Realtime WebSocket / Socket.io Path (matches backend REALTIME_PATH)
VITE_REALTIME_PATH=/socket.io

# Google Maps Platform Web SDK Key
VITE_GOOGLE_MAPS_API_KEY=

# Mappls Web SDK Key (Optional secondary fallback)
VITE_MAPPLS_MAP_KEY=

# Analytics Tracking ID (Optional)
VITE_ANALYTICS_ID=
