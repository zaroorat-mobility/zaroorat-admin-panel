# ==============================================================================
# ZAROORAT MOBILITY ADMIN PANEL - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Realtime WebSocket / Socket.io Path
VITE_REALTIME_PATH=/socket.io

# Google Maps Platform Client SDK Key (Used for Web JavaScript SDK & Canvas)
VITE_GOOGLE_MAPS_API_KEY=

# Mappls (MapmyIndia) Web SDK Key (Optional secondary fallback)
VITE_MAPPLS_MAP_KEY=

# Analytics Tracking ID (Optional)
VITE_ANALYTICS_ID=
